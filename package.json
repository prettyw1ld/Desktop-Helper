{
  "name": "pushik",
  "productName": "Пушик",
  "version": "0.9.0",
  "description": "Кот Пуш: десктопный питомец-помощник, который гуляет по рабочему столу",
  "main": "build/main.js",
  "scripts": {
    "build": "node tools/build.mts",
    "watch": "node tools/build.mts --watch",
    "typecheck": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && tsc -p tsconfig.test.json",
    "test": "node tools/build.mts --tests && node --test \"build/test/*.test.js\"",
    "prestart": "node tools/build-mac-locator.mts && npm run build",
    "start": "electron .",
    "predist": "node tools/build-mac-locator.mts && npm run typecheck && npm run build",
    "dist": "electron-builder",
    "dist:win": "npm run predist && electron-builder --win",
    "dist:mac": "npm run predist && electron-builder --mac",
    "postinstall": "node tools/fetch-vosk-model.mts",
    "vosk": "node tools/fetch-vosk-model.mts"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/node": "^26.6.6",
    "electron": "^45.3.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.prettyw1ld.pushik",
    "productName": "Пушик",
    "files": [
      "build/**/*",
      "!build/test/**",
      "!build/**/*.map",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Пушик слушает, что ты хочешь сделать, когда ты нажимаешь на микрофон.",
        "NSScreenCaptureUsageDescription": "Пушик смотрит на экран, чтобы показать лапкой, куда нажать."
      }
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "extraResources": [
      {
        "from": "team.json",
        "to": "team.json",
        "filter": [
          "team.json"
        ]
      }
    ],
    "asarUnpack": [
      "assets/mac/**"
    ],
    "directories": {
      "buildResources": "build-resources",
      "output": "dist"
    },
    "afterPack": "tools/fuses.cjs"
  },
  "author": "prettyw1ld",
  "license": "MIT",
  "repository": "https://github.com/prettyw1ld/Desktop-Helper",
  "dependencies": {
    "node-ical": "^0.27.3",
    "vosk-browser": "^0.0.8"
  },
  "engines": {
    "node": ">=22.18"
  }
}
