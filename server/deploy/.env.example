# Скопируйте в .env и заполните. .env не кладите в git.
DB_PASSWORD=
# тот же секрет, что presence.secret в политике, от 16 знаков: openssl rand -base64 24
ENROLL_SECRET=
# вход в админ-панель (пользователь admin), от 12 знаков
ADMIN_PASSWORD=
# открытый ключ из `node tools/config-sign.mjs keygen …`; пусто — настройки с сервера не проверяются сервером (Пушик проверяет всегда)
CONFIG_PUBLIC_KEY=
TLS_DIR=./tls
