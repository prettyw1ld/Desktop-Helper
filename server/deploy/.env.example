# Скопируйте в .env и заполните. .env не кладите в git.
DB_PASSWORD=
# тот же секрет, что presence.secret в политике, от 16 знаков: openssl rand -base64 24
ENROLL_SECRET=
# вход в админ-панель (пользователь admin), от 12 знаков
ADMIN_PASSWORD=
# открытый ключ из `node tools/config-sign.mjs keygen …`; пусто — настройки с сервера не проверяются сервером (Пушик проверяет всегда)
CONFIG_PUBLIC_KEY=
TLS_DIR=./tls

# --- единый вход (docker-compose.sso.yml), необязательно ---
# адрес панели, как его видят администраторы
PUBLIC_URL=https://pushik.corp
# OIDC: Keycloak — https://sso.corp/realms/<realm>; клиент confidential, в токене нужен claim groups
OIDC_ISSUER=
OIDC_CLIENT_ID=pushik-admin
OIDC_CLIENT_SECRET=
# openssl rand -base64 32 | tr -- '+/' '-_'
COOKIE_SECRET=
# общий секрет nginx → сервер, от 16 знаков: openssl rand -base64 24
PROXY_SECRET=
# группы каталога через запятую: смотреть / ещё и выкладывать настройки, забывать устройства
ADMIN_VIEW_GROUPS=soc-analysts
ADMIN_CONFIG_GROUPS=soc-admins
